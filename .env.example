# Скопируйте в .env и заполните. Переменные окружения имеют приоритет над .env.

# --- сервер
ADDR=:8080
PUBLIC_URL=http://localhost:8080      # внешний адрес, на проде https://autoinvest.by
DATA_DIR=data                         # база SQLite и файлы верификации
APP_ENV=development                   # production — JSON-логи и запрет демо-рынка
LOG_LEVEL=info

# --- администратор (создаётся при первом запуске; существующий аккаунт НЕ повышается)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- рыночные данные: live (Binance → Bybit → CoinGecko, акции — Yahoo Finance, курсы НБРБ) или fixture (офлайн-демо для разработки)
# Если НБРБ недоступен, используется последний сохранённый настоящий курс; покупки по курсу старше суток не проводятся.
MARKET=live

# --- платежи: sandbox (тестовая платёжка, деньги не списываются) или bepaid
PAYMENTS=sandbox
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
BEPAID_TEST=true                      # false — боевые списания (только вместе с BROKER=whitebird)
BEPAID_PUBLIC_KEY=                    # ключ для проверки подписи вебхуков (кабинет bePaid)

# --- исполнение сделок: paper (учёт по реальным ценам) или whitebird (после договора с партнёром)
BROKER=paper
WHITEBIRD_API_URL=
WHITEBIRD_API_KEY=
WHITEBIRD_API_SECRET=

# --- Telegram-бот (@BotFather)
# Банк карты: обычно его присылает эквайринг; если нет — справочник BIN (binlist.net, с кэшем). off — не обращаться
BIN_LOOKUP=binlist
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SUPPORT_CHAT_ID=             # чат команды для уведомлений о новых обращениях (ответ reply в этом чате уходит клиенту)
# Без токена при разработке работает встроенный тестовый Telegram (окно /telegram-sandbox). TELEGRAM_SANDBOX=false — выключить.
TELEGRAM_SANDBOX=

# --- вход через Google и Apple (OAUTH_*=sandbox|on|off; пусто — при разработке тестовые страницы, в продакшене выкл.)
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web).
#   Authorized redirect URI: <PUBLIC_URL>/oauth/google/callback
OAUTH_GOOGLE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple выключен (OAUTH_APPLE=off), пока нет аккаунта разработчика. Чтобы включить —
# Apple: developer.apple.com → Identifiers → Services ID (Sign in with Apple), Return URL: <PUBLIC_URL>/oauth/apple/callback;
#   Keys → ключ с Sign in with Apple (.p8). Работает только с настоящим доменом и HTTPS.
OAUTH_APPLE=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
APPLE_PRIVATE_KEY=

# --- вход по телефону: номер подтверждается кнопкой «Поделиться номером» в нашем Telegram-боте,
# коды для входа бот присылает в Telegram — SMS-шлюз не нужен (работает, когда запущен бот).

# --- почта (без SMTP письма пишутся в лог)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AutoInvest <no-reply@autoinvest.by>

# --- условия (копейки и базисные пункты: 100 bp = 1%)
REQUIRE_KYC=false

# --- проверка личности
# Пусто = по умолчанию: при разработке тестовые режимы, в продакшене МСИ выключено, документы — ручная проверка.
# KYC_DOCS=sandbox|sumsub|manual   MSI_MODE=sandbox|oauth|off
KYC_DOCS=
MSI_MODE=
# Sumsub (паспорт + селфи): ключи из кабинета Sumsub → Dev space; вебхук: <PUBLIC_URL>/api/v1/webhooks/sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL=basic-kyc-level
# МСИ (межбанковская система идентификации, оператор ОАО «НКФО «ЕРИП»): адреса и ключи выдаёт оператор после договора
MSI_AUTH_URL=
MSI_TOKEN_URL=
MSI_USERINFO_URL=
MSI_CLIENT_ID=
MSI_CLIENT_SECRET=
MSI_SCOPE=
FEE_FREE_BP=100
FEE_PRO_BP=50
SPREAD_BP=100
PRO_MONTH_KOP=990
PRO_YEAR_KOP=8900
MIN_CONTRIBUTION_KOP=500
MAX_CONTRIBUTION_KOP=500000
FREE_PLAN_LIMIT=3
PRO_PLAN_LIMIT=20
SCHEDULER_SECONDS=30
